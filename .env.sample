# Copy to .env and fill values before running
# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/event_horizon_db

# Session secret for express-session
SESSION_SECRET=change_me_to_a_strong_random_value

# Optional: Replit OIDC client id (if using Replit provider). If not set, OIDC is disabled and local auth works.
REPL_ID=

# Optional: OIDC issuer URL (default is Replit OIDC)
ISSUER_URL=

# PORT the server should listen on (default 5000)
PORT=5000
